<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="single_joint_limit_switch">
  <!-- Single-joint example that homes using a limit switch. -->
  <xacro:arg name="can_iface" default="can0"/>
  <xacro:arg name="motor_id" default="4"/>
  <xacro:arg name="limit_switch_can_id" default="385"/>
  <xacro:arg name="limit_switch_active_high" default="true"/>
  <xacro:arg name="joint_lower_limit" default="-100"/>
  <xacro:arg name="joint_upper_limit" default="100"/>
  <xacro:arg name="homing_search_direction" default="negative"/>
  <xacro:arg name="homing_position" default="0.5"/>
  <xacro:arg name="homing_approach_speed" default="0.05"/>
  <xacro:arg name="homing_backoff_speed" default="0.05"/>
  <xacro:arg name="homing_fine_speed" default="0.01"/>
  <xacro:arg name="homing_backoff_distance" default="0.05"/>
  <xacro:property name="actuator_name" value="motor$(arg motor_id)"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>
      <material name="base_blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.05 0.05"/>
      </geometry>
      <material name="link_orange">
        <color rgba="0.9 0.5 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="$(arg joint_lower_limit)" upper="$(arg joint_upper_limit)" effort="10" velocity="1"/>
  </joint>

  <ros2_control name="CanSystem" type="system">
    <hardware>
      <plugin>mr2_can_hardware_interface/CanHW</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <param name="actuator">${actuator_name}</param>
      <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
      <param name="motor_id">$(arg motor_id)</param>
      <param name="can_iface">$(arg can_iface)</param>
      <param name="joint_lower_limit">$(arg joint_lower_limit)</param>
      <param name="joint_upper_limit">$(arg joint_upper_limit)</param>
      <param name="homing_plugin">mr2_can_hardware_interface/LimitSwitchPolicy</param>
      <param name="homing_device_can_iface">$(arg can_iface)</param>
      <param name="homing_device_can_id">$(arg limit_switch_can_id)</param>
      <param name="homing_device_state_name">joint1/limit_switch_state</param>
      <param name="homing_device_active_high">$(arg limit_switch_active_high)</param>
      <param name="homing_device_active_high">$(arg limit_switch_active_high)</param>
      <param name="homing_search_direction">$(arg homing_search_direction)</param>
      <param name="homing_position">$(arg homing_position)</param>
      <param name="homing_approach_speed">$(arg homing_approach_speed)</param>
      <param name="homing_backoff_speed">$(arg homing_backoff_speed)</param>
      <param name="homing_fine_speed">$(arg homing_fine_speed)</param>
      <param name="homing_backoff_distance">$(arg homing_backoff_distance)</param>
    </joint>

    <transmission name="joint1_transmission">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <actuator name="${actuator_name}" role="${actuator_name}">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </actuator>
      <joint name="joint1" role="joint1">
        <mechanical_reduction>1.0</mechanical_reduction>
      </joint>
    </transmission>
  </ros2_control>
</robot>
