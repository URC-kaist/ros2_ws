<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Joint limits (shared with ros2_control config) -->
  <xacro:property name="arm_j1_lower_limit" value="-100"/>
  <xacro:property name="arm_j1_upper_limit" value="100"/>
  <xacro:property name="arm_j2_lower_limit" value="-100"/>
  <xacro:property name="arm_j2_upper_limit" value="100"/>
  <xacro:property name="arm_j3_lower_limit" value="-100"/>
  <xacro:property name="arm_j3_upper_limit" value="100"/>
  <xacro:property name="arm_j4_lower_limit" value="-3.5"/>
  <xacro:property name="arm_j4_upper_limit" value="3.5"/>
  <xacro:property name="arm_j5_lower_limit" value="-3.65"/>
  <xacro:property name="arm_j5_upper_limit" value="0.18"/>
  <xacro:property name="arm_j6_lower_limit" value="-4"/>
  <xacro:property name="arm_j6_upper_limit" value="4"/>
  <!-- Shared shaded material for STL visuals (prevents unlit white appearance) -->
  <material name="ArmGrey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <!-- Use file:// URI for meshes so both RViz (resource_retriever) and Gazebo resolve correctly -->
  <xacro:property name="manipulator_mesh_prefix" value="file://$(find mr2_rover_description)/meshes/manipulator"/>
  <xacro:property name="manipulator_mesh_scale" value="0.001"/>

  <xacro:macro name="manipulator" params="length:=0.73 width:=0.49 height:=0.19">
    <link name="arm_l1">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="${manipulator_mesh_prefix}/rover_manipulator_link1.stl"
                scale="${manipulator_mesh_scale} ${manipulator_mesh_scale} ${manipulator_mesh_scale}"/>
        </geometry>
        <origin xyz="0 0 0.032" rpy="0 0 3.1415926536"/>
        <material name="ArmGrey"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.15" length="0.1"/>
        </geometry>
        <origin xyz="0 0 0.05"/>
      </collision>
    </link>
    <link name="arm_l2">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="${manipulator_mesh_prefix}/rover_manipulator_link2.stl"
                scale="${manipulator_mesh_scale} ${manipulator_mesh_scale} ${manipulator_mesh_scale}"/>
        </geometry>
        <origin xyz="-0.070 0 -0.104" rpy="0 0 3.1415926536"/>
        <material name="ArmGrey"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.02" length="0.4"/>
        </geometry>
        <origin xyz="0 0 0.2"/>
      </collision>
    </link>
    <link name="arm_l3">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="${manipulator_mesh_prefix}/rover_manipulator_link3.stl"
                scale="${manipulator_mesh_scale} ${manipulator_mesh_scale} ${manipulator_mesh_scale}"/>
        </geometry>
        <origin xyz="-0.070 0.0001 -0.599" rpy="0 0 3.1415926536"/>
        <material name="ArmGrey"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.05" length="0.05"/>
        </geometry>
        <origin xyz="0.025 0 0" rpy="0 -1.571 0"/>
      </collision>
    </link>
    <link name="arm_l4">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="${manipulator_mesh_prefix}/rover_manipulator_link4.stl"
                scale="${manipulator_mesh_scale} ${manipulator_mesh_scale} ${manipulator_mesh_scale}"/>
        </geometry>
        <origin xyz="-0.140 0.000 -0.461" rpy="0 0 3.1415926536"/>
        <material name="ArmGrey"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.02" length="0.2"/>
        </geometry>
        <origin xyz="0 0 -0.1"/>
      </collision>
    </link>
    <link name="arm_l5">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="${manipulator_mesh_prefix}/rover_manipulator_link5.stl"
                scale="${manipulator_mesh_scale} ${manipulator_mesh_scale} ${manipulator_mesh_scale}"/>
        </geometry>
        <origin xyz="-0.140 0.000 -0.201" rpy="0 0 3.1415926536"/>
        <material name="ArmGrey"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.05" length="0.1"/>
        </geometry>
        <origin xyz="0.05 0 0" rpy="0 -1.571 0"/>
      </collision>
    </link>
    <link name="arm_l6">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.1 0.1 0.1"/>
        </geometry>
        <origin xyz="0.05 0 0" rpy="0 0 0"/>
        <material name="ArmGrey"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.1 0.1 0.1"/>
        </geometry>
        <origin xyz="0.05 0 0" rpy="0 0 0"/>
      </collision>
    </link>
    <joint name="arm_j1" type="revolute">
      <parent link="base_link"/>
      <child link="arm_l1"/>
      <origin xyz="${length/2.0} 0 ${height}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${arm_j1_lower_limit}" upper="${arm_j1_upper_limit}" effort="50" velocity="1.0"/>
    </joint>
    <joint name="arm_j2" type="revolute">
      <parent link="arm_l1"/>
      <child link="arm_l2"/>
      <origin xyz="0.070 0 0.136" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${arm_j2_lower_limit}" upper="${arm_j2_upper_limit}" effort="50" velocity="1.0"/>
    </joint>
    <joint name="arm_j3" type="revolute">
      <parent link="arm_l2"/>
      <child link="arm_l3"/>
      <origin xyz="0 0 0.495" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${arm_j3_lower_limit}" upper="${arm_j3_upper_limit}" effort="50" velocity="1.0"/>
    </joint>
    <joint name="arm_j4" type="revolute">
      <parent link="arm_l3"/>
      <child link="arm_l4"/>
      <origin xyz="0.070 0 -0.138" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${arm_j4_lower_limit}" upper="${arm_j4_upper_limit}" effort="50" velocity="1.0"/>
    </joint>
    <joint name="arm_j5" type="revolute">
      <parent link="arm_l4"/>
      <child link="arm_l5"/>
      <origin xyz="0 0 -0.260" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${arm_j5_lower_limit}" upper="${arm_j5_upper_limit}" effort="50" velocity="1.0"/>
    </joint>
    <joint name="arm_j6" type="revolute">
      <parent link="arm_l5"/>
      <child link="arm_l6"/>
      <origin xyz="0.116 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${arm_j6_lower_limit}" upper="${arm_j6_upper_limit}" effort="50" velocity="1.0"/>
    </joint>
  </xacro:macro>
</robot>
