<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rover_gazebo_sensors" params="ros2_control_config">
    <!-- ros2_control plugin that loads the TwistToCommands controller -->
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <robot_param>robot_description</robot_param>
        <robot_param_node>robot_state_publisher</robot_param_node>
        <parameters>${ros2_control_config}</parameters>
      </plugin>
    </gazebo>

    <gazebo reference="left_gnss">
      <sensor name="left_gnss_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>1</update_rate>
        <visualize>true</visualize>
        <topic>left_gnss/navsat</topic>
        <ignition_frame_id>left_gnss</ignition_frame_id>
      </sensor>
    </gazebo>

    <gazebo reference="right_gnss">
      <sensor name="right_gnss_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>1</update_rate>
        <visualize>true</visualize>
        <topic>right_gnss/navsat</topic>
        <ignition_frame_id>right_gnss</ignition_frame_id>
      </sensor>
    </gazebo>

    <gazebo reference="front_camera">
      <sensor name="front_camera_sensor" type="rgbd_camera">
        <update_rate>60</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>rgbd_camera</topic>
        <ignition_frame_id>front_camera</ignition_frame_id>
        <camera>
          <horizontal_fov>1.0472</horizontal_fov>
          <lens>
            <intrinsics>
              <!-- fx = fy = width / ( 2 * tan (hfov / 2 ) ) -->
              <fx>277.12735</fx>
              <fy>277.12735</fy>
              <!-- cx = ( width + 1 ) / 2 -->
              <cx>160.5</cx>
              <!-- cy = ( height + 1 ) / 2 -->
              <cy>120.5</cy>
              <s>0</s>
            </intrinsics>
          </lens>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <image>
            <width>320</width>
            <height>240</height>
	    <anti_aliasing>4</anti_aliasing>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.01</near>
            <far>300</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>

    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <topic>imu</topic>
        <ignition_frame_id>imu_link</ignition_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
