<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rover_can_ros2_control" params="name can_iface:=can0">

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>mr2_can_hardware_interface/CanHW</plugin>
      </hardware>

      <!-- <joint name="arm_j1"> -->
      <!--   <command_interface name="position"/> -->
      <!--   <state_interface name="position"/> -->
      <!--   <state_interface name="velocity"/> -->
      <!--   <state_interface name="effort"/> -->
      <!--   <param name="actuator">motor1</param> -->
      <!--   <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param> -->
      <!--   <param name="motor_id">101</param> -->
      <!--   <param name="can_iface">${can_iface}</param> -->
      <!--   <param name="joint_lower_limit">${arm_j1_lower_limit}</param> -->
      <!--   <param name="joint_upper_limit">${arm_j1_upper_limit}</param> -->
      <!--   <param name="homing_plugin">mr2_can_hardware_interface/AbsoluteEncoderPolicy</param> -->
      <!--   <param name="homing_device_can_iface">${can_iface}</param> -->
      <!--   <param name="homing_device_can_id">201</param> -->
      <!--   <param name="homing_device_ticks_per_rev">4096</param> -->
      <!-- </joint> -->
      <!---->
      <joint name="arm_j2">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="actuator">motor2</param>
        <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
        <param name="motor_id">102</param>
        <param name="can_iface">${can_iface}</param>
        <param name="joint_lower_limit">${arm_j2_lower_limit}</param>
        <param name="joint_upper_limit">${arm_j2_upper_limit}</param>
        <param name="homing_plugin">mr2_can_hardware_interface/LimitSwitchPolicy</param>
        <param name="homing_position">-0.69</param>
        <param name="homing_device_can_iface">${can_iface}</param>
        <param name="homing_device_can_id">202</param>
        <param name="homing_device_active_high">true</param>
        <param name="homing_search_direction">negative</param>
        <param name="homing_approach_speed">0.1</param>
        <param name="homing_fine_speed">0.02</param>
        <param name="homing_backoff_distance">0.05</param>
      </joint>

      <joint name="arm_j3">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="actuator">motor3</param>
        <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
        <param name="motor_id">103</param>
        <param name="can_iface">${can_iface}</param>
        <param name="joint_lower_limit">${arm_j3_lower_limit}</param>
        <param name="joint_upper_limit">${arm_j3_upper_limit}</param>
        <param name="homing_plugin">mr2_can_hardware_interface/AbsoluteEncoderPolicy</param>
        <param name="homing_offset">5.05</param>
        <param name="homing_split_angle">2.7</param>
        <param name="homing_encoder_direction">-1.0</param>
        <param name="homing_device_can_iface">${can_iface}</param>
        <param name="homing_device_can_id">203</param>
        <param name="homing_device_ticks_per_rev">4096</param>
      </joint>

      <joint name="arm_j4">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="actuator">motor4</param>
        <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
        <param name="motor_id">104</param>
        <param name="can_iface">${can_iface}</param>
        <param name="joint_lower_limit">${arm_j4_lower_limit}</param>
        <param name="joint_upper_limit">${arm_j4_upper_limit}</param>
        <param name="homing_plugin">mr2_can_hardware_interface/LimitSwitchPolicy</param>
        <param name="homing_position">-2.55</param>
        <param name="homing_device_can_iface">${can_iface}</param>
        <param name="homing_device_can_id">204</param>
        <param name="homing_device_active_high">true</param>
        <param name="homing_search_direction">negative</param>
        <param name="homing_approach_speed">0.35</param>
        <param name="homing_fine_speed">0.05</param>
        <param name="homing_backoff_distance">0.12</param>
      </joint>

      <joint name="arm_j5">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="actuator">motor5</param>
        <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
        <param name="motor_id">105</param>
        <param name="can_iface">${can_iface}</param>
        <param name="joint_lower_limit">${arm_j5_lower_limit}</param>
        <param name="joint_upper_limit">${arm_j5_upper_limit}</param>
        <param name="homing_plugin">mr2_can_hardware_interface/AbsoluteEncoderPolicy</param>
        <param name="homing_offset">2.53</param>
        <param name="homing_split_angle">0.98</param>
        <param name="homing_encoder_direction">-1.0</param>
        <param name="homing_device_can_iface">${can_iface}</param>
        <param name="homing_device_can_id">205</param>
        <param name="homing_device_ticks_per_rev">4096</param>
      </joint>

      <joint name="arm_j6">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="actuator">motor6</param>
        <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
        <param name="motor_id">106</param>
        <param name="can_iface">${can_iface}</param>
        <param name="joint_lower_limit">${arm_j6_lower_limit}</param>
        <param name="joint_upper_limit">${arm_j6_upper_limit}</param>
        <param name="homing_plugin">mr2_can_hardware_interface/LimitSwitchPolicy</param>
        <param name="homing_device_can_id">206</param>
        <param name="homing_device_can_iface">${can_iface}</param>
        <param name="homing_position">-3.03</param>
        <param name="homing_device_active_high">true</param>
        <param name="homing_search_direction">negative</param>
        <param name="homing_approach_speed">0.35</param>
        <param name="homing_fine_speed">0.05</param>
        <param name="homing_backoff_distance">0.12</param>
      </joint>

      <!-- <transmission name="arm_j1_transmission"> -->
      <!--   <plugin>transmission_interface/SimpleTransmission</plugin> -->
      <!--   <actuator name="motor1" role="motor1"> -->
      <!--     <command_interface name="position"/> -->
      <!--     <state_interface name="position"/> -->
      <!--     <state_interface name="velocity"/> -->
      <!--     <state_interface name="effort"/> -->
      <!--   </actuator> -->
      <!--   <joint name="arm_j1" role="arm_j1"> -->
      <!--     <mechanical_reduction>3.0</mechanical_reduction> -->
      <!--   </joint> -->
      <!-- </transmission> -->

      <transmission name="arm_j2_j3_transmission">
        <plugin>transmission_interface/FourBarLinkageTransmission</plugin>
        <actuator name="motor2" role="motor2">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
          <mechanical_reduction>50.0</mechanical_reduction>
        </actuator>
        <actuator name="motor3" role="motor3">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
          <mechanical_reduction>50.0</mechanical_reduction>
        </actuator>
        <joint name="arm_j2" role="arm_j2">
          <mechanical_reduction>-1.0</mechanical_reduction>
          <offset>0.0</offset>
        </joint>
        <joint name="arm_j3" role="arm_j3">
          <mechanical_reduction>1.0</mechanical_reduction>
          <offset>0.0</offset>
        </joint>
      </transmission>

      <transmission name="arm_j4_transmission">
        <plugin>transmission_interface/SimpleTransmission</plugin>
        <actuator name="motor4" role="motor4">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </actuator>
        <joint name="arm_j4" role="arm_j4">
          <mechanical_reduction>1.0</mechanical_reduction>
        </joint>
      </transmission>

      <transmission name="arm_j5_transmission">
        <plugin>transmission_interface/SimpleTransmission</plugin>
        <actuator name="motor5" role="motor5">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </actuator>
        <joint name="arm_j5" role="arm_j5">
          <mechanical_reduction>1.0</mechanical_reduction>
        </joint>
      </transmission>

      <transmission name="arm_j6_transmission">
        <plugin>transmission_interface/SimpleTransmission</plugin>
        <actuator name="motor6" role="motor6">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </actuator>
        <joint name="arm_j6" role="arm_j6">
          <mechanical_reduction>1.0</mechanical_reduction>
        </joint>
      </transmission>

    </ros2_control>
  </xacro:macro>

</robot>
