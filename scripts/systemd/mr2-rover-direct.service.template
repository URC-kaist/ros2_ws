[Unit]
Description=MR2 rover-direct PTY, gateway, and manual ROS 2 stack
Requires=nginx.service
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
User=__MR2_USER__
Group=__MR2_GROUP__
WorkingDirectory=__REPO_ROOT__/rover/ros2_ws
EnvironmentFile=-__REPO_ROOT__/.env
Environment=ROS_LOCALHOST_ONLY=1
Environment=MR2_NODE_BIN=__NODE_BIN__
ExecStart=__REPO_ROOT__/scripts/run_rover_direct.bash
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
