[Unit]
Description=MR2 rover-local gateway and video relay
Requires=mr2-xbee-sim.service
After=network-online.target mr2-xbee-sim.service
Wants=network-online.target

[Service]
Type=simple
User=__MR2_USER__
Group=__MR2_GROUP__
WorkingDirectory=__REPO_ROOT__/base/gateway
EnvironmentFile=-__REPO_ROOT__/.env
Environment=MR2_GATEWAY_PROFILE=rover-direct
ExecStart=__NODE_BIN__ __REPO_ROOT__/base/gateway/index.js --gateway-profile rover-direct --base-xbee-device /run/mr2/xbee_gateway --gateway-host 127.0.0.1 --gateway-port 8081 --mavproxy-enable false --antenna-enable false --rocket-m2-enable false --ros-topic-relay-enable false
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
