#######################################################################
# MR2 serial device udev rules
#
# Copy to /etc/udev/rules.d/99-mr2-serial.rules using the install script:
#   ./scripts/install_udev_serial_rules.bash
#
# Add one line per device. Example entry:
# SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", MODE:="0666", GROUP:="plugdev"
#######################################################################
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", ATTRS{serial}=="D30JZD4O", MODE:="0666", GROUP:="dialout", SYMLINK+="ttyXBEE"
# RealSense D435i RGB stream — map only the RGB capture node (interface 03, index 0).
SUBSYSTEM=="video4linux", KERNEL=="video*", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", ENV{ID_USB_INTERFACE_NUM}=="03", ATTR{index}=="0", MODE:="0666", GROUP:="video", SYMLINK+="videoRGBD"
# Front camera (Suyin rev 0x5805, USB path 2.3) — map only the capture node (index 0)
SUBSYSTEM=="video4linux", KERNEL=="video*", ATTRS{idVendor}=="1e45", ATTRS{idProduct}=="8022", ATTRS{bcdDevice}=="5805", ATTRS{serial}=="200910120001", ATTRS{devpath}=="2.3", ATTR{index}=="0", MODE:="0666", GROUP:="video", SYMLINK+="videoFRONT"
# Gripper camera via hub on front-camera USB port (Suyin rev 0x5805, USB path 2.3.2) — map only the capture node (index 0)
SUBSYSTEM=="video4linux", KERNEL=="video*", ATTRS{idVendor}=="1e45", ATTRS{idProduct}=="8022", ATTRS{bcdDevice}=="5805", ATTRS{serial}=="200910120001", ATTRS{devpath}=="2.3.2", ATTR{index}=="0", MODE:="0666", GROUP:="video", SYMLINK+="videoGRIPPER"
# Arm camera via hub on front-camera USB port (Suyin rev 0x5805, USB path 2.3.4) — map only the capture node (index 0)
SUBSYSTEM=="video4linux", KERNEL=="video*", ATTRS{idVendor}=="1e45", ATTRS{idProduct}=="8022", ATTRS{bcdDevice}=="5805", ATTRS{serial}=="200910120001", ATTRS{devpath}=="2.3.4", ATTR{index}=="0", MODE:="0666", GROUP:="video", SYMLINK+="videoARM"
# Front-left camera (Suyin rev 0x5805, USB path 2.4.1) — map only the capture node (index 0)
SUBSYSTEM=="video4linux", KERNEL=="video*", ATTRS{idVendor}=="1e45", ATTRS{idProduct}=="8022", ATTRS{bcdDevice}=="5805", ATTRS{serial}=="200910120001", ATTRS{devpath}=="2.4.1", ATTR{index}=="0", MODE:="0666", GROUP:="video", SYMLINK+="videoFL"
# Left camera (Suyin rev 0x5805, USB path 2.4.2) — map only the capture node (index 0)
SUBSYSTEM=="video4linux", KERNEL=="video*", ATTRS{idVendor}=="1e45", ATTRS{idProduct}=="8022", ATTRS{bcdDevice}=="5805", ATTRS{serial}=="200910120001", ATTRS{devpath}=="2.4.2", ATTR{index}=="0", MODE:="0666", GROUP:="video", SYMLINK+="videoLEFT"
# Right camera (Suyin rev 0x5805, USB path 2.4.3) — map only the capture node (index 0)
SUBSYSTEM=="video4linux", KERNEL=="video*", ATTRS{idVendor}=="1e45", ATTRS{idProduct}=="8022", ATTRS{bcdDevice}=="5805", ATTRS{serial}=="200910120001", ATTRS{devpath}=="2.4.3", ATTR{index}=="0", MODE:="0666", GROUP:="video", SYMLINK+="videoRIGHT"
# Front-right camera (Suyin rev 0x5805, USB path 2.4.4) — map only the capture node (index 0)
SUBSYSTEM=="video4linux", KERNEL=="video*", ATTRS{idVendor}=="1e45", ATTRS{idProduct}=="8022", ATTRS{bcdDevice}=="5805", ATTRS{serial}=="200910120001", ATTRS{devpath}=="2.4.4", ATTR{index}=="0", MODE:="0666", GROUP:="video", SYMLINK+="videoFR"
# Top mast camera (Suyin rev 0x5801) — map only the capture node (index 0)
SUBSYSTEM=="video4linux", KERNEL=="video*", ATTRS{idVendor}=="1e45", ATTRS{idProduct}=="8022", ATTRS{bcdDevice}=="5801", ATTR{index}=="0", MODE:="0666", GROUP:="video", SYMLINK+="videoTOP"

# UBLOX ZED-F9P/F9R (CDC-ACM). The u-blox launch selects receivers by
# DEVICE_SERIAL_STRING, so this rule only sets permissions and disables
# ModemManager probing; it intentionally does not create /dev symlinks.
ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", MODE="0666", GROUP="plugdev", ENV{ID_MM_DEVICE_IGNORE}="1"
