#######################################################################
# MR2 serial device udev rules
#
# Copy to /etc/udev/rules.d/99-mr2-serial.rules using the install script:
#   ./scripts/install_udev_serial_rules.bash
#
# Add one line per device. Example entries:
# SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", ATTRS{serial}=="DM03L0C6", MODE:="0666", GROUP:="dialout", SYMLINK+="IMU"
# SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", MODE:="0666", GROUP:="plugdev"
#######################################################################
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", ATTRS{serial}=="D30K21VR", MODE:="0666", GROUP:="dialout", SYMLINK+="ttySIK"
# Front camera (Suyin rev 0x5805) — map only the capture node (index 0)
SUBSYSTEM=="video4linux", KERNEL=="video*", ATTRS{idVendor}=="1e45", ATTRS{idProduct}=="8022", ATTRS{bcdDevice}=="5805", ATTR{index}=="0", MODE:="0666", GROUP:="video", SYMLINK+="videoFRONT"
# Top mast camera (Suyin rev 0x5801) — map only the capture node (index 0)
SUBSYSTEM=="video4linux", KERNEL=="video*", ATTRS{idVendor}=="1e45", ATTRS{idProduct}=="8022", ATTRS{bcdDevice}=="5801", ATTR{index}=="0", MODE:="0666", GROUP:="video", SYMLINK+="videoTOP"

# UBLOX ZED-F9P/F9R (CDC-ACM)
ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", MODE="0666", GROUP="plugdev", ENV{ID_MM_DEVICE_IGNORE}="1"
