#######################################################################
# MR2 base station udev serial rules
#
# Copy to /etc/udev/rules.d/99-mr2-base-station.rules using the install script:
#   ./scripts/install_udev_base_station_rules.bash
#
# Add one line per device here.
#######################################################################
ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", MODE="0666", GROUP="plugdev", ENV{ID_MM_DEVICE_IGNORE}="1"

SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", ATTRS{serial}=="DU0D8YJ3", MODE:="0666", GROUP:="dialout", SYMLINK+="ttySIK"

# Arduino FTDI USB serial: /dev/serial/by-id/usb-FTDI_FT232R_USB_UART_A5069RR4-if00-port0
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="A5069RR4", MODE:="0666", GROUP:="dialout", ENV{ID_MM_DEVICE_IGNORE}="1", SYMLINK+="ttyARDUINO"
