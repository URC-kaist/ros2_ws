#######################################################################
# MR2 base station udev serial rules
#
# Copy to /etc/udev/rules.d/99-mr2-base-station.rules using the install script:
#   ./scripts/install_udev_base_station_rules.bash
#
# Add one line per device here.
#######################################################################
# UBLOX ZED-F9P/F9R GPS. The base launch selects receivers by u-blox
# metadata, so this rule only sets permissions and disables ModemManager.
ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", MODE:="0666", GROUP:="plugdev", ENV{ID_MM_DEVICE_IGNORE}="1"

# XBEE radio: /dev/serial/by-id/usb-FTDI_FT231X_USB_UART_D30JZD4V-if00-port0
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", ATTRS{serial}=="D30JZD4V", MODE:="0666", GROUP:="dialout", ENV{ID_MM_DEVICE_IGNORE}="1", SYMLINK+="ttyXBEE"

# Arduino FTDI USB serial: /dev/serial/by-id/usb-FTDI_USB_Serial_Converter_FTB6SPL3-if00-port0
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="FTB6SPL3", MODE:="0666", GROUP:="dialout", ENV{ID_MM_DEVICE_IGNORE}="1", SYMLINK+="ttyARDUINO"
