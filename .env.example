# Copy this file to `.env` for shared MR2 network defaults.
#
# Scripts and services should read these top-level values before applying
# component-specific overrides.

# Base station dashboard/nginx address.
MR2_BASE_IP=192.168.1.101

# Rover address used by base-side nginx to reach rosbridge.
MR2_ROVER_IP=192.168.1.102

# Rocket M2 management addresses.
MR2_BASE_ROCKET_IP=192.168.1.100
MR2_DRONE_ROCKET_IP=192.168.1.103
MR2_ROVER_ROCKET_IP=192.168.1.106

# Local service ports.
MR2_GATEWAY_HOST=127.0.0.1
MR2_GATEWAY_PORT=8081
MR2_ROSBRIDGE_PORT=9090
