  <version>0.0.1</version>
  <description>System status publisher using psutil.</description>
  <maintainer email="gmmyung@kaist.ac.kr">mr2</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>diagnostic_msgs</depend>
