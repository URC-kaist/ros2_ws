<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="four_bar_transmission">
  <xacro:arg name="can_iface" default="can0"/>
  <xacro:arg name="motor_a_id" default="102"/>
  <xacro:arg name="motor_b_id" default="103"/>
  <xacro:arg name="input_limit_can_id" default="183"/>
  <xacro:arg name="output_abs_can_id" default="0x182"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>
      <material name="base_gray">
        <color rgba="0.35 0.35 0.4 1.0"/>
      </material>
    </visual>
  </link>

  <link name="input_link">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.04 0.04"/>
      </geometry>
      <material name="input_orange">
        <color rgba="0.8 0.4 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <link name="output_link">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.04 0.04"/>
      </geometry>
      <material name="output_blue">
        <color rgba="0.1 0.4 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="input_joint" type="revolute">
    <parent link="base_link"/>
    <child link="input_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="2.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="output_joint" type="revolute">
    <parent link="input_link"/>
    <child link="output_link"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="2.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <ros2_control name="FourBarSystem" type="system">
    <hardware>
      <plugin>mr2_can_hardware_interface/CanHW</plugin>
    </hardware>

    <joint name="input_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <param name="actuator">motor2</param>
      <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
      <param name="motor_id">$(arg motor_a_id)</param>
      <param name="can_iface">$(arg can_iface)</param>
      <!-- <param name="homing_plugin">mr2_can_hardware_interface/LimitSwitchPolicy</param> -->
      <!-- <param name="homing_limit_state">input_joint_limit_switch</param> -->
      <!-- <param name="homing_limit_watchdog_state">input_joint_limit_switch_watchdog</param> -->
      <!-- <param name="homing_search_direction">negative</param> -->
      <!-- <param name="homing_approach_speed">0.35</param> -->
      <!-- <param name="homing_fine_speed">0.05</param> -->
      <!-- <param name="homing_backoff_distance">0.12</param> -->
    </joint>

    <joint name="output_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <param name="actuator">motor3</param>
      <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
      <param name="motor_id">$(arg motor_b_id)</param>
      <param name="can_iface">$(arg can_iface)</param>
      <!-- <param name="homing_plugin">mr2_can_hardware_interface/AbsoluteEncoderPolicy</param> -->
      <!-- <param name="homing_encoder_state">output_joint_abs</param> -->
      <!-- <param name="homing_encoder_watchdog_state">output_joint_abs_watchdog</param> -->
    </joint>

    <gpio name="input_joint_limit_sensor">
      <param name="device_plugin">mr2_devices_sensors/LimitSwitchDevice</param>
      <param name="can_iface">$(arg can_iface)</param>
      <param name="can_id">$(arg input_limit_can_id)</param>
      <param name="state_name">input_joint_limit_switch</param>
      <param name="edge_name">input_joint_limit_edge</param>
      <param name="active_high">true</param>
    </gpio>

    <gpio name="output_joint_abs_encoder">
      <param name="device_plugin">mr2_devices_sensors/AbsoluteEncoderDevice</param>
      <param name="can_iface">$(arg can_iface)</param>
      <param name="can_id">$(arg output_abs_can_id)</param>
      <param name="state_name">output_joint_abs</param>
      <param name="flags_name">output_joint_abs_flags</param>
      <param name="ticks_per_rev">4096</param>
    </gpio>

    <transmission name="four_bar_transmission">
      <plugin>transmission_interface/FourBarLinkageTransmission</plugin>
      <actuator name="motor2" role="motor2">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <mechanical_reduction>1.0</mechanical_reduction>
      </actuator>
      <actuator name="motor3" role="motor3">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <mechanical_reduction>1.0</mechanical_reduction>
      </actuator>
      <joint name="input_joint" role="input_joint">
        <mechanical_reduction>1.0</mechanical_reduction>
        <offset>0.0</offset>
      </joint>
      <joint name="output_joint" role="output_joint">
        <mechanical_reduction>1.0</mechanical_reduction>
        <offset>0.0</offset>
      </joint>
    </transmission>
  </ros2_control>
</robot>
