<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="single_joint">
  <xacro:arg name="can_iface" default="can0"/>
  <xacro:arg name="motor_id" default="4"/>
  <xacro:property name="actuator_name" value="motor$(arg motor_id)"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>
      <material name="base_blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.05 0.05"/>
      </geometry>
      <material name="link_orange">
        <color rgba="0.9 0.5 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <ros2_control name="CanSystem" type="system">
    <hardware>
      <plugin>mr2_can_hardware_interface/CanHW</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <param name="actuator">${actuator_name}</param>
      <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
      <param name="motor_id">$(arg motor_id)</param>
      <param name="can_iface">$(arg can_iface)</param>
      <param name="homing_plugin">mr2_can_hardware_interface/LimitSwitchPolicy</param>
      <param name="homing_limit_state">joint1/limit_switch_state</param>
      <param name="homing_limit_watchdog_state">joint1/limit_switch_state_watchdog</param>
      <param name="homing_search_direction">negative</param>
      <param name="homing_approach_speed">0.10</param>
      <param name="homing_backoff_speed">0.05</param>
      <param name="homing_fine_speed">0.03</param>
      <param name="homing_backoff_distance">0.08</param>
      <param name="homing_home_position">0.0</param>
    </joint>



    <gpio name="joint1_aux_encoder">
      <param name="device_plugin">mr2_devices_sensors/AbsoluteEncoderDevice</param>
      <param name="can_iface">$(arg can_iface)</param>
      <param name="can_id">0x180</param>
      <param name="ticks_per_rev">4096</param>
      <param name="direction">1.0</param>
      <param name="zero_offset_deg">0.0</param>
      <param name="state_name">joint1/encoder_aux_angle</param>
      <param name="raw_name">joint1/encoder_aux_raw</param>
      <param name="flags_name">joint1/encoder_aux_flags</param>
    </gpio>


    <gpio name="joint1_limit_switch">
      <param name="device_plugin">mr2_devices_sensors/LimitSwitchDevice</param>
      <param name="can_iface">$(arg can_iface)</param>
      <param name="can_id">0x181</param>
      <param name="state_name">joint1/limit_switch_state</param>
      <param name="active_high">true</param>
    </gpio>
    <transmission name="joint1_transmission">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <actuator name="${actuator_name}" role="${actuator_name}">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </actuator>
      <joint name="joint1" role="joint1">
        <mechanical_reduction>1.0</mechanical_reduction>
      </joint>
    </transmission>
  </ros2_control>
</robot>
