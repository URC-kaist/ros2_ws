<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rover_can_ros2_control" params="name can_iface:=can0">

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>mr2_can_hardware_interface/CanHW</plugin>
      </hardware>

      <joint name="arm_j1">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="actuator">motor1</param>
        <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
        <param name="motor_id">1</param>
        <param name="can_iface">${can_iface}</param>
        <param name="homing_plugin">mr2_can_hardware_interface/AbsoluteEncoderPolicy</param>
        <param name="homing_encoder_state">arm_j1_abs</param>
        <param name="homing_encoder_error_state">arm_j1_abs_error</param>
      </joint>

      <joint name="arm_j2">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="actuator">motor2</param>
        <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
        <param name="motor_id">2</param>
        <param name="can_iface">${can_iface}</param>
        <param name="homing_plugin">mr2_can_hardware_interface/CoupledLimitEncoderPolicy</param>
        <param name="homing_group">arm_j2_j3</param>
        <param name="homing_limit_state">arm_j2_limit_switch</param>
        <param name="homing_encoder_state">arm_j3_abs</param>
        <param name="homing_search_direction">negative</param>
        <param name="homing_approach_speed">0.35</param>
        <param name="homing_fine_speed">0.05</param>
        <param name="homing_backoff_distance">0.12</param>
        <param name="homing_limit_error_state">arm_j2_limit_switch_error</param>
      </joint>

      <joint name="arm_j3">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="actuator">motor3</param>
        <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
        <param name="motor_id">3</param>
        <param name="can_iface">${can_iface}</param>
        <param name="homing_plugin">mr2_can_hardware_interface/CoupledLimitEncoderPolicy</param>
        <param name="homing_group">arm_j2_j3</param>
        <param name="homing_encoder_error_state">arm_j3_abs_error</param>
      </joint>

      <joint name="arm_j4">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="actuator">motor4</param>
        <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
        <param name="motor_id">4</param>
        <param name="can_iface">${can_iface}</param>
      </joint>

      <joint name="arm_j5">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="actuator">motor5</param>
        <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
        <param name="motor_id">5</param>
        <param name="can_iface">${can_iface}</param>
      </joint>

      <joint name="arm_j6">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="actuator">motor6</param>
        <param name="device_plugin">mr2_devices_ak_servo/AkServoDevice</param>
        <param name="motor_id">6</param>
        <param name="can_iface">${can_iface}</param>
      </joint>

      <gpio name="arm_j2_limit_sensor">
        <param name="device_plugin">mr2_devices_sensors/LimitSwitchDevice</param>
        <param name="can_iface">${can_iface}</param>
        <param name="can_id">0x181</param>
        <param name="state_name">arm_j2_limit_switch</param>
        <param name="edge_name">arm_j2_limit_edge</param>
        <param name="active_high">true</param>
      </gpio>

      <gpio name="arm_j1_abs_encoder">
        <param name="device_plugin">mr2_devices_sensors/AbsoluteEncoderDevice</param>
        <param name="can_iface">${can_iface}</param>
        <param name="can_id">0x180</param>
        <param name="state_name">arm_j1_abs</param>
        <param name="flags_name">arm_j1_abs_flags</param>
        <param name="ticks_per_rev">4096</param>
      </gpio>

      <gpio name="arm_j3_abs_encoder">
        <param name="device_plugin">mr2_devices_sensors/AbsoluteEncoderDevice</param>
        <param name="can_iface">${can_iface}</param>
        <param name="can_id">0x182</param>
        <param name="state_name">arm_j3_abs</param>
        <param name="flags_name">arm_j3_abs_flags</param>
        <param name="ticks_per_rev">4096</param>
      </gpio>

      <transmission name="arm_j1_transmission">
        <plugin>transmission_interface/SimpleTransmission</plugin>
        <actuator name="motor1" role="motor1">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </actuator>
        <joint name="arm_j1" role="arm_j1">
          <mechanical_reduction>3.0</mechanical_reduction>
        </joint>
      </transmission>

      <transmission name="arm_j2_j3_transmission">
        <plugin>transmission_interface/FourBarLinkageTransmission</plugin>
        <actuator name="motor2" role="motor2">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
          <mechanical_reduction>50.0</mechanical_reduction>
        </actuator>
        <actuator name="motor3" role="motor3">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
          <mechanical_reduction>50.0</mechanical_reduction>
        </actuator>
        <joint name="arm_j2" role="arm_j2">
          <mechanical_reduction>1.0</mechanical_reduction>
          <offset>0.0</offset>
        </joint>
        <joint name="arm_j3" role="arm_j3">
          <mechanical_reduction>1.0</mechanical_reduction>
          <offset>0.0</offset>
        </joint>
      </transmission>

      <transmission name="arm_j4_transmission">
        <plugin>transmission_interface/SimpleTransmission</plugin>
        <actuator name="motor4" role="motor4">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </actuator>
        <joint name="arm_j4" role="arm_j4">
          <mechanical_reduction>1.0</mechanical_reduction>
        </joint>
      </transmission>

      <transmission name="arm_j5_transmission">
        <plugin>transmission_interface/SimpleTransmission</plugin>
        <actuator name="motor5" role="motor5">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </actuator>
        <joint name="arm_j5" role="arm_j5">
          <mechanical_reduction>1.0</mechanical_reduction>
        </joint>
      </transmission>

      <transmission name="arm_j6_transmission">
        <plugin>transmission_interface/SimpleTransmission</plugin>
        <actuator name="motor6" role="motor6">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </actuator>
        <joint name="arm_j6" role="arm_j6">
          <mechanical_reduction>1.0</mechanical_reduction>
        </joint>
      </transmission>

    </ros2_control>
  </xacro:macro>

</robot>
