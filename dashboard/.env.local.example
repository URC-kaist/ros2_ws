# Copy this file to `.env.local` for dashboard-specific local overrides.
#
# Example:
#   cp .env.local.example .env.local
#
# Leave values blank when the browser reaches services through the same host
# that serves the dashboard and proxies `/rosbridge-ws`, `/sik-ws`, and
# `/transitive/token`.

# Full rosbridge websocket URL.
# Example: ws://mr2-ubuntu:9090
# Default when unset: ws(s)://<current-host>/rosbridge-ws
VITE_ROSBRIDGE_URL=

# Full MR2 base gateway websocket URL.
# Example: ws://mr2-ubuntu:8081/sik-ws
# Default when unset: ws(s)://<current-host>/sik-ws
VITE_SIK_WS_URL=

# HTTP endpoint used to mint Transitive JWTs for browser video feeds.
# Example: http://mr2-ubuntu:8081/transitive/token
# Default when unset: http(s)://<current-origin>/transitive/token
VITE_TRANSITIVE_TOKEN_URL=

# Optional query parameters forwarded to the token endpoint above.
# Fill these only if your Transitive token service expects them.
VITE_TRANSITIVE_ID=
VITE_TRANSITIVE_DEVICE=
VITE_TRANSITIVE_CAPABILITY=
VITE_TRANSITIVE_USER_ID=
VITE_TRANSITIVE_VALIDITY=

# Optional metadata override written into spectrometer CSV exports when the
# backend response does not provide a calibration path.
VITE_SPECTRO_CALIBRATION_PATH=
