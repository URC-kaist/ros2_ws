# Backwards-compatible env template.
# For local development, prefer copying `.env.local.example` to `.env.local`.

# Full rosbridge websocket URL.
# Default when unset: ws(s)://<current-host>/rosbridge-ws
VITE_ROSBRIDGE_URL=

# Full MR2 base gateway websocket URL.
# Default when unset: ws(s)://<current-host>/sik-ws
VITE_SIK_WS_URL=

# HTTP endpoint used to mint Transitive JWTs.
# Default when unset: http(s)://<current-origin>/transitive/token
VITE_TRANSITIVE_TOKEN_URL=

# Optional query parameters forwarded to the Transitive token endpoint.
VITE_TRANSITIVE_ID=
VITE_TRANSITIVE_DEVICE=
VITE_TRANSITIVE_CAPABILITY=
VITE_TRANSITIVE_USER_ID=
VITE_TRANSITIVE_VALIDITY=

# Optional metadata override used when exporting spectrometer CSV files.
VITE_SPECTRO_CALIBRATION_PATH=
