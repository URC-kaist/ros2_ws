# Override these when the dashboard is not served behind the same host as the
# gateway and rosbridge reverse proxies.

# Example: ws://mr2-ubuntu:9090
VITE_ROSBRIDGE_URL=

# Example: ws://mr2-ubuntu:8081/sik-ws
VITE_SIK_WS_URL=

# Example: http://mr2-ubuntu:8081/transitive/token
VITE_TRANSITIVE_TOKEN_URL=
