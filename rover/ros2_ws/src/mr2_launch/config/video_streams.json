      "udp_port": 5000,
      "ros_encoding": "rgb8",
      "width": 640,
      "height": 480,
      "framerate": 15,
      "encoder": {
        "bitrate_kbps": 1600,
        "keyframe_interval": 30,
        "speed_preset": "ultrafast",
        "tune": "zerolatency"
      },
      "display": {
        "label": "Front Nav",
        "panel": "delivery",
        "order": 1
      }
