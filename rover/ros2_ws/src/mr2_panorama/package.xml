  <version>0.0.0</version>
  <description>Direct V4L2 panorama capture action server for MR2 Rover.</description>
  <maintainer email="159106973+pianojay@users.noreply.github.com">menny</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>camera_calibration_parsers</depend>
  <depend>mr2_action_interface</depend>
