<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3">
  <BehaviorTree ID="MissionMaster">
    <Sequence name="MissionMasterRoot">
      <WaitForMissionList/>
      <ReactiveFallback name="PauseGate">
        <Sequence name="PauseSequence">
          <PauseRequested/>
          <PauseActiveMission clear_costmap="{clear_costmap}"/>
          <WaitForResume/>
        </Sequence>
        <Sequence name="DispatchMission">
          <SelectNextMission mission="{mission}"/>
          <Fallback name="MissionTypeSelector">
            <Sequence name="RunGnssOnly">
              <IsMissionType mission="{mission}" expected="GNSS_ONLY"/>
              <SubTree ID="GnssOnlyMission" mission="{mission}"/>
            </Sequence>
            <Sequence name="RunCoverVision">
              <IsMissionType mission="{mission}" expected="COVER_VISION"/>
              <SubTree ID="CoverVisionMission" mission="{mission}"/>
            </Sequence>
          </Fallback>
        </Sequence>
      </ReactiveFallback>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="WaitForMissionList"/>
    <Action ID="SelectNextMission">
      <output_port name="mission">Next mission spec</output_port>
    </Action>
    <Condition ID="IsMissionType">
      <input_port name="mission">Mission spec</input_port>
      <input_port name="expected">Expected mission type</input_port>
    </Condition>
    <Condition ID="PauseRequested"/>
    <Action ID="PauseActiveMission">
      <input_port name="clear_costmap">Clear costmap on pause</input_port>
    </Action>
    <Condition ID="WaitForResume"/>
  </TreeNodesModel>
</root>
